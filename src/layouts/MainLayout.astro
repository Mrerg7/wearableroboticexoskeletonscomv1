---
import '../styles/global.css';
import {
  SITE,
  OG_IMAGE,
  OG_IMAGE_WIDTH,
  OG_IMAGE_HEIGHT,
} from '../constants/site';
import type { FaqItem } from '../data/faq';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  noindex?: boolean;
  faq?: FaqItem[];
}

const {
  title = SITE.title,
  description = SITE.description,
  image = OG_IMAGE,
  canonicalPath = '/',
  noindex = false,
  faq = [],
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, SITE.url).href;
const siteUrl = `${SITE.url}/`;
const siteName = SITE.name;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: siteName,
      description: SITE.description,
      inLanguage: SITE.language,
      datePublished: SITE.datePublished,
      dateModified: SITE.dateModified,
      publisher: {
        '@type': 'Organization',
        '@id': `${siteUrl}#organization`,
        name: SITE.owner,
        url: siteUrl,
        email: SITE.email,
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}#website` },
      inLanguage: SITE.language,
      datePublished: SITE.datePublished,
      dateModified: SITE.dateModified,
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: image,
        width: OG_IMAGE_WIDTH,
        height: OG_IMAGE_HEIGHT,
        contentUrl: image,
      },
      breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
      about: {
        '@type': 'Thing',
        name: `${SITE.domain} premium domain`,
        sameAs: siteUrl,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteUrl,
        },
      ],
    },
    {
      '@type': 'Product',
      '@id': `${siteUrl}#product`,
      name: `${SITE.domain} Premium Domain`,
      description:
        'The exact-match, authoritative .com domain for the wearable robotic exoskeleton industry. Category-defining digital real estate positioned for the multi-billion-dollar exoskeleton revolution.',
      url: siteUrl,
      image: [image],
      category: 'Domain Name',
      brand: {
        '@type': 'Brand',
        name: siteName,
      },
      additionalProperty: [
        { '@type': 'PropertyValue', name: 'Domain name', value: SITE.domain },
        { '@type': 'PropertyValue', name: 'TLD', value: '.com' },
        { '@type': 'PropertyValue', name: 'Category', value: 'Exact-match premium domain' },
        { '@type': 'PropertyValue', name: 'Status', value: 'Available for acquisition' },
        { '@type': 'PropertyValue', name: 'Industry', value: 'Wearable robotic exoskeletons' },
      ],
      offers: {
        '@type': 'AggregateOffer',
        availability: 'https://schema.org/InStock',
        lowPrice: SITE.valuationLow,
        highPrice: SITE.valuationHigh,
        priceCurrency: 'USD',
        offerCount: 1,
        url: canonicalUrl,
        priceValidUntil: SITE.priceValidUntil,
        eligibleTransactionType: 'https://schema.org/Trade',
        seller: {
          '@type': 'Organization',
          '@id': `${siteUrl}#organization`,
          name: SITE.owner,
          email: SITE.email,
          url: siteUrl,
        },
        description: `Valuation range $${SITE.valuationLow.toLocaleString('en-US')}–$${SITE.valuationHigh.toLocaleString('en-US')}. Serious offers considered; flexible terms available.`,
        shippingDetails: {
          '@type': 'OfferShippingDetails',
          shippingRate: {
            '@type': 'MonetaryAmount',
            value: '0.00',
            currency: 'USD',
          },
          deliveryTime: {
            '@type': 'ShippingDeliveryTime',
            handlingTime: {
              '@type': 'QuantitativeValue',
              minValue: 0,
              maxValue: 1,
              unitCode: 'DAY',
            },
            transitTime: {
              '@type': 'QuantitativeValue',
              minValue: 0,
              maxValue: 0,
              unitCode: 'DAY',
            },
          },
          shippingDestination: {
            '@type': 'DefinedRegion',
            addressCountry: 'US',
          },
        },
        hasMerchantReturnPolicy: {
          '@type': 'MerchantReturnPolicy',
          returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
          merchantReturnDays: 0,
          applicableCountry: 'US',
          name: 'No Returns',
          description:
            'Due to the nature of digital domain name assets, returns are not applicable after transfer. Escrow-backed transactions protect the buyer during transfer.',
        },
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: SITE.owner,
      alternateName: siteName,
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: image,
        width: OG_IMAGE_WIDTH,
        height: OG_IMAGE_HEIGHT,
      },
      image,
      sameAs: [
        'https://github.com/Mrerg7',
        `https://github.com/Mrerg7/wearableroboticexoskeletonscomv1`,
      ],
      areaServed: 'Worldwide',
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: SITE.email,
        availableLanguage: 'English',
      },
    },
    ...(faq.length > 0
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${canonicalUrl}#faq`,
            mainEntity: faq.map((item) => ({
              '@type': 'Question',
              name: item.question,
              acceptedAnswer: {
                '@type': 'Answer',
                text: item.answer,
              },
            })),
          },
        ]
      : []),
  ],
};
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <meta name="author" content={SITE.owner} />
  <meta name="theme-color" content="#080b12" />
  <meta name="format-detection" content="telephone=no" />

  <!-- Google Site Verification -->
  <meta name="google-site-verification" content={SITE.googleSiteVerification} />

  <!-- Robots -->
  <meta
    name="robots"
    content={noindex
      ? 'noindex, nofollow'
      : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
  />

  {!noindex && <link rel="canonical" href={canonicalUrl} />}
  {!noindex && <link rel="alternate" hreflang="en" href={canonicalUrl} />}
  {!noindex && <link rel="alternate" hreflang="x-default" href={canonicalUrl} />}
  {!noindex && <link rel="describedby" type="text/markdown" href="/llms.txt" />}
  {!noindex && <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM site summary" />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {!noindex && <meta property="og:url" content={canonicalUrl} />}
  <meta property="og:locale" content={SITE.locale} />
  <meta property="og:image" content={image} />
  <meta property="og:image:secure_url" content={image} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:alt" content="Wearable Robotic Exoskeleton — premium high-tech human augmentation" />
  <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
  <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <meta name="twitter:image:alt" content="Wearable Robotic Exoskeleton — premium high-tech human augmentation" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://imagedelivery.net" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  <link rel="author" href="/humans.txt" />
  <link rel="security-contact" href={`mailto:${SITE.email}`} />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
<body class="bg-exo-black text-white font-sans antialiased">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-exo-blue focus:text-white focus:rounded-lg"
  >
    Skip to main content
  </a>
  <slot />
</body>
</html>
